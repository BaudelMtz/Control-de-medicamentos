<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fondo Verde Oscuro -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/primary_green"/>
        </shape>
    </item>

    <!-- Círculo decorativo superior izquierda -->
    <item android:top="-100dp" android:left="-100dp">
        <shape android:shape="oval">
            <solid android:color="#1AFFFFFF"/>
            <size android:width="300dp" android:height="300dp"/>
        </shape>
    </item>

    <!-- Círculo decorativo inferior derecha -->
    <item android:bottom="-50dp" android:right="-50dp">
        <shape android:shape="oval">
            <solid android:color="#0DFFFFFF"/>
            <size android:width="200dp" android:height="200dp"/>
        </shape>
    </item>
</layer-list>