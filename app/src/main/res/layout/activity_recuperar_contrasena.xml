<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btn_enviar"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:id="@+id/tv_volver_inicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← Volver al inicio de sesión"
                android:textColor="#1B6443"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="32dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Restablece tu contraseña"
                android:fontFamily="serif"
                android:textStyle="bold"
                android:textSize="32sp"
                android:textColor="#111111"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ingresa tu correo y te enviaremos un enlace para restablecer la contraseña."
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_marginBottom="32dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Correo electrónico"
                android:textStyle="bold"
                android:textColor="#111111"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"/>

            <!-- EditText Corregido con ID -->
            <EditText
                android:id="@+id/et_correo"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_input_redondeado"
                android:hint="  correo@ejemplo.com"
                android:drawableStart="@android:drawable/ic_dialog_email"
                android:paddingHorizontal="16dp"
                android:inputType="textEmailAddress"
                android:layout_marginBottom="24dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_captcha_box"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Selecciona todas las imágenes con puentes"
                    android:textColor="#333333"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Fila 1 de imágenes -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:id="@+id/img_captcha_1"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_captcha_image"
                            android:padding="16dp"
                            android:src="@drawable/puente" />

                        <ImageView
                            android:id="@+id/img_captcha_2"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginHorizontal="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_captcha_image"
                            android:padding="16dp"
                            android:src="@drawable/casa_1" />

                        <ImageView
                            android:id="@+id/img_captcha_3"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_captcha_image"
                            android:padding="16dp"
                            android:src="@drawable/arbol_1" />
                    </LinearLayout>

                    <!-- Fila 2 de imágenes -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:id="@+id/img_captcha_4"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_captcha_image"
                            android:padding="16dp"
                            android:src="@drawable/puente" />

                        <ImageView
                            android:id="@+id/img_captcha_5"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginHorizontal="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_captcha_image"
                            android:padding="16dp"
                            android:src="@drawable/casa_2" />

                        <ImageView
                            android:id="@+id/img_captcha_6"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_captcha_image"
                            android:padding="16dp"
                            android:src="@drawable/puente" />
                    </LinearLayout>

                    <!-- Fila 3 de imágenes -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:id="@+id/img_captcha_7"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_captcha_image"
                            android:padding="16dp"
                            android:src="@drawable/casa_3" />

                        <ImageView
                            android:id="@+id/img_captcha_8"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginHorizontal="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_captcha_image"
                            android:padding="16dp"
                            android:src="@drawable/arbol_2" />

                        <ImageView
                            android:id="@+id/img_captcha_9"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_captcha_image"
                            android:padding="16dp"
                            android:src="@drawable/puente" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Botón VERIFY Corregido con ID -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_verify_captcha"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_boton_verify"
                    android:backgroundTint="@null"
                    android:text="VERIFY"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:paddingHorizontal="24dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Botón Enviar con ID -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_enviar"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_boton_verde_oscuro"
        android:backgroundTint="@null"
        android:text="Enviar correo para restablecer contraseña"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>